rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "lyricalmyricalbooks@gmail.com"
        && request.auth.token.email_verified == true;
    }
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /assets/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /digital-assets/{allPaths=**} {
      allow read: if false; // Only accessible via Admin SDK signed URLs on the backend
      allow write: if isAdmin();
    }
  }
}
