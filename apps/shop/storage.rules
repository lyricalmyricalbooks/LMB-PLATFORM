rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // The shared system (docs/shared-system.md): each shop's files live in its own folder, shops/{shopId}/, and a
    // sign-in only counts in the shop whose sign-in list (tenant) it came from, as in firestore.rules signedInHere().
    match /shops/{shopId} {
      // The shop's record in the shared database, written only by the platform: its tenant and owner address.
      function shopRecord() {
        return firestore.get(/databases/(default)/documents/shops/$(shopId)).data;
      }
      function signedInHere() {
        return request.auth != null
          && request.auth.token.firebase.get("tenant", "") == shopRecord().get("tenant", "-");
      }
      // Platform support, as in firestore.rules isSupport(): staff access until its "until" time, custom sign-in only,
      // for an "edit" visit. A "view" visit (plan 9.8) uploads nothing; the photos it sees are public anyway.
      function isSupport() {
        return signedInHere()
          && request.auth.token.firebase.sign_in_provider == "custom"
          && request.auth.token.get("support", null) is map
          && request.auth.token.support.get("mode", "view") == "edit"
          && request.auth.token.support.get("until", 0) is number
          && request.time.toMillis() < request.auth.token.support.until * 1000;
      }
      // Same admin check as firestore.rules (functions/roles.js): the owner address or a Team role on the pass.
      function isAdmin() {
        return isSupport() || (signedInHere()
          && request.auth.token.email_verified == true
          && (request.auth.token.email == shopRecord().get("ownerEmail", "-")
            || request.auth.token.get("role", "") in ["owner", "staff"]));
      }
      match /products/{allPaths=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /assets/{allPaths=**} {
        allow read: if true;
        allow write: if isAdmin();
      }
      match /digital-assets/{allPaths=**} {
        allow read: if false; // Only accessible via Admin SDK signed URLs on the backend
        allow write: if isAdmin();
      }
    }
  }
}
