{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/generate-sitemap.mjs && node scripts/build-storefront-data.mjs && node scripts/prerender-storefront.mjs",
    "build:shared": "node scripts/build-shared.mjs",
    "build:setup": "vite build --config vite.setup.config.ts && vite build --config vite.design.config.ts",
    "build:sitemap": "node scripts/generate-sitemap.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "deploy:github": "git push origin main",
    "check:readability": "node scripts/check-readability.mjs",
    "test": "vitest run",
    "typecheck": "node scripts/typecheck-ratchet.mjs",
    "lint": "node scripts/lint-ratchet.mjs",
    "test:studio": "node scripts/studio-e2e.mjs",
    "test:storefront": "node scripts/storefront-smoke.mjs",
    "test:a11y": "node scripts/a11y-check.mjs",
    "test:admin-phone": "node scripts/admin-phone-check.mjs",
    "test:move": "node scripts/move-check.mjs",
    "test:speed": "node scripts/speed-check.mjs",
    "test:studio-controls": "AUDIT_CHECK=1 node scripts/studio-control-audit.mjs",
    "test:template-buttons": "node scripts/template-buttons-check.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@stripe/stripe-js": "^10.2.0",
    "barcode-detector": "^3.2.3",
    "firebase": "13.2.0",
    "lucide-react": "1.66.0",
    "motion": "14.9.0",
    "next-themes": "0.4.6",
    "qrcode-generator": "1.4.4",
    "quill": "2.0.3",
    "react-hot-toast": "^2.6.1",
    "react-resizable-panels": "4.15.0",
    "react-router": "8.5.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "8.3.5",
      "@grpc/grpc-js": "^1.14.6",
      "protobufjs": "^7.6.6",
      "browserslist": "^4.28.7",
      "source-map-js": "^1.2.2"
    }
  },
  "overrides": {
    "vite": "8.3.5",
    "@grpc/grpc-js": "^1.14.6",
    "protobufjs": "^7.6.6",
    "browserslist": "^4.28.7",
    "source-map-js": "^1.2.2"
  }
}
