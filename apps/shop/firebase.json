{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        "*.test.js",
        "*.test.ts",
        "*.fakes.mjs",
        "README.md"
      ],
      "runtime": "nodejs22"
    }
  ],
  "hosting": {
    "site": "lmb-test-shop",
    "public": "dist",
    "ignore": [],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [],
    "rewrites": [
      {
        "regex": "^/(?:(?:books|collections|page)/[^/]+/?|(?:account|admin)(?:/.*)?|cart|checkout|track|wishlist)$",
        "destination": "/spa.html"
      }
    ],
    "headers": [
      {
        "regex": "^/assets/.+$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "regex": "^/(?:favicon[^/]*|apple-touch-icon|icon-[^/]+|admin-icon-[^/]+)\\.(?:ico|png)$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "regex": "^/(?:|spa|404|(?:books|collections|page)/.*|(?:account|admin)(?:/.*)?|cart|checkout|track|wishlist|[^/]+\\.(?:xml|txt|json)|shop-profile\\.js|.*\\.html)$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "regex": "^/(?:spa|404|cart|checkout|track|wishlist|(?:account|admin)(?:/.*)?)(?:\\.html)?$",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "regex": "^/.*$",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), usb=()"
          }
        ]
      }
    ]
  }
}
