rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
  // The shared system (LMB-PLATFORM docs/shared-system.md): each shop's stockroom files live in its own folder,
  // shops/{shopId}/, and a sign-in only counts in the shop whose sign-in list (tenant) it came from. The shop's record
  // (tenant, owner address) is read from the shop database's shops/{shopId}, written only by the platform.
  match /shops/{shopId} {

    function shopRecord() {
      return firestore.get(/databases/(default)/documents/shops/$(shopId)).data;
    }
    function signedInHere() {
      return request.auth != null
        && request.auth.token.firebase.get('tenant', '') == shopRecord().get('tenant', '-');
    }

    // Same check as isPublisher() in firestore.rules: the owner address or the
    // owner role, with email_verified (see the reasons there).
    function isPublisher() {
      return signedInHere()
        && request.auth.token.email_verified == true
        && (request.auth.token.email == shopRecord().get('ownerEmail', '-')
            || request.auth.token.get('role', '') == 'owner');
    }

    // Mirrors isBookAuthor() in firestore.rules (a verified address only, see there), resolved cross-service against
    // the same settings/bookOwners map ({ bookId: authorEmailLower }) the
    // publisher client maintains on every catalog save. Guarded by exists() so
    // a missing map denies rather than erroring.
    function isBookAuthor(bookId) {
      return signedInHere()
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && firestore.exists(/databases/(default)/documents/shops/$(shopId)/settings/bookOwners)
        && request.auth.token.email.lower() ==
             firestore.get(/databases/(default)/documents/shops/$(shopId)/settings/bookOwners)
               .data.get(bookId, '');
    }

    // Receipts are uploaded as `receipts/{bookId}/{timestamp}_{filename}`
    // (see _fbUploadReceipt + the caller in main.js), so the owning book is the
    // first path segment and access can be scoped per book.
    //
    // Previously ANY authenticated user could read, overwrite and delete ANY
    // receipt in the bucket — one author could wipe another author's expense
    // evidence. Now the publisher and the owning author are the only writers,
    // and deletes are likewise scoped instead of open to every signed-in user.
    //
    // Caveat worth knowing: getDownloadURL() hands back a tokenised public URL,
    // and the app stores those URLs in book state. Anyone holding such a URL can
    // still fetch that one file without passing these rules — tightening `read`
    // stops path enumeration and un-tokenised access, not links already issued.
    // Original email text is evidence too. This exception is publisher-only
    // and scoped to finder imports; it does not broaden author uploads.
    // A book's cover for the Fair till (features/book-cover.js): a small JPEG the publisher uploads. Anyone signed in
    // may read it (a fair helper's till shows it; the address is a tokenised link anyway).
    match /covers/{bookId}/{file} {
      allow read: if signedInHere();
      allow write: if isPublisher()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isPublisher();
    }
    match /receipts/email-imports/{allPaths=**} {
      allow read, delete: if isPublisher();
      allow write: if isPublisher()
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('text/plain|image/.*|application/pdf');
    }
    match /receipts/{bookId}/{allPaths=**} {
      // Storage rules OR permissions from every matching block. Exclude the
      // reserved email-import namespace here so its publisher-only policy
      // above cannot be widened if a catalog book is ever named
      // "email-imports".
      allow read: if bookId != 'email-imports'
        && (isPublisher() || isBookAuthor(bookId));
      // Writes stay constrained to reasonably sized images/PDFs so the bucket
      // can't be used as free file storage or filled with junk that runs up
      // egress/storage costs.
      allow write: if bookId != 'email-imports'
        && (isPublisher() || isBookAuthor(bookId))
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
      allow delete: if bookId != 'email-imports'
        && (isPublisher() || isBookAuthor(bookId));
    }
  }
  }
}
