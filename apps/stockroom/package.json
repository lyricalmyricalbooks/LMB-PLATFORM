{
  "name": "stockroom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check:hosting": "node scripts/hostingCheck.mjs",
    "preview": "vite preview",
    "dev:backend": "node backend/server.js",
    "dev:all": "sh -c \"npm run dev:backend & npm run dev\"",
    "lint": "eslint src --ext .js",
    "lint:contrast": "node scripts/check-contrast.mjs",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e/fair-day.mjs",
    "check:styles": "node scripts/e2e/style-snapshot.mjs",
    "shots": "node scripts/phone-shots/capture.mjs",
    "android:assets": "node scripts/android-assets.mjs"
  },
  "devDependencies": {
    "@vite-pwa/assets-generator": "^2.0.0",
    "acorn": "^8.16.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright-core": "1.64.1",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
