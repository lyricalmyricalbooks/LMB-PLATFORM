{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "README.md", "*.test.js", "publish.js", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Cache-Control", "value": "max-age=60" }
        ]
      }
    ]
  }
}
