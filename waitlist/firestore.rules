rules_version = '2';
// The platform project's database. Through the web it holds waitlist sign-ups, which the public page adds and nobody
// else reads (the owner reads them in the Firebase console), and the public status summary (status/), which anyone may
// read and only the platform's own server writes. Every other path is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    function text(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    match /waitlist/{id} {
      // Matches waitlist/signup.js: one record per email, keyed by the first 32 hex characters of its SHA-256.
      allow create: if request.resource.data.keys().hasOnly(
            ["email", "name", "press", "plan", "today", "source", "firstSignedUpAt", "lastSignedUpAt", "signups"])
        && request.resource.data.keys().hasAll(
            ["email", "name", "plan", "source", "firstSignedUpAt", "lastSignedUpAt", "signups"])
        && text(request.resource.data.email, 6, 254)
        && request.resource.data.email.matches('^[^\\s@A-Z]+@[^\\s@A-Z]+[.][^\\s@A-Z]+$')
        && id == hashing.sha256(request.resource.data.email).toHexString().lower()[0:32]
        && text(request.resource.data.name, 1, 120)
        && text(request.resource.data.get("press", ""), 0, 160)
        && request.resource.data.plan in ["shop", "stockroom", "both", "unsure"]
        && text(request.resource.data.get("today", ""), 0, 500)
        && text(request.resource.data.source, 1, 120)
        && text(request.resource.data.firstSignedUpAt, 20, 30)
        && request.resource.data.lastSignedUpAt == request.resource.data.firstSignedUpAt
        && request.resource.data.signups == 1;
    }

    // The setup record (signup/pressRecord.js, code plan 18.2). The press's owner reads it and changes only its setup
    // answers. The platform's own server sets status, the staged import file and the timestamps; a press can set none of
    // them. The document id is the press id, and the owner's email must be the verified email on the sign-in.
    match /presses/{pressId} {
      function signedIn() {
        return request.auth != null && request.auth.token.email_verified == true;
      }
      function ownsIt() {
        return signedIn() && resource.data.ownerUid == request.auth.uid;
      }
      function setupKeys() {
        return ["pressName", "sells", "country", "look"];
      }
      allow read: if ownsIt();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.pressId == pressId
        && request.resource.data.status == "setup"
        && request.resource.data.stagedImportPath == ""
        && request.resource.data.keys().hasOnly(["pressId", "ownerUid", "ownerEmail", "status", "pressName", "sells",
            "country", "look", "stagedImportPath", "createdAt", "lastSeenAt"])
        && request.resource.data.keys().hasAll(["pressId", "ownerUid", "ownerEmail", "status", "createdAt", "lastSeenAt"])
        && text(request.resource.data.get("pressName", ""), 0, 120)
        && text(request.resource.data.get("sells", ""), 0, 300)
        && text(request.resource.data.get("country", ""), 0, 2)
        && text(request.resource.data.get("look", ""), 0, 40);
      allow update: if ownsIt()
        && resource.data.status == "setup"
        && request.resource.data.pressId == resource.data.pressId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        && request.resource.data.status == resource.data.status
        && request.resource.data.stagedImportPath == resource.data.stagedImportPath
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(["pressId", "ownerUid", "ownerEmail", "status", "pressName", "sells",
            "country", "look", "stagedImportPath", "createdAt", "lastSeenAt"])
        && text(request.resource.data.get("pressName", ""), 0, 120)
        && text(request.resource.data.get("sells", ""), 0, 300)
        && text(request.resource.data.get("country", ""), 0, 2)
        && text(request.resource.data.get("look", ""), 0, 40);
      allow delete: if false;
    }

    // status/publish.js writes it with the platform's token; it names no shop (status/summary.js).
    match /publicStatus/current {
      allow get: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
